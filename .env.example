# Environment Variables
# Copy this file to .env.local and fill in the values

# --- Public (exposed to browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (never exposed to browser) ---

# Production site URL (server-only, used for payment return/cancel/webhook URLs)
# On Vercel Production: set to https://your-domain.com
# On Vercel Preview: leave unset (falls back to VERCEL_URL automatically)
# Locally: leave unset (falls back to localhost:3000)
SITE_URL=

SUPABASE_SERVICE_ROLE_KEY=

# payOS Payment Provider
# Obtain from: https://my.payos.vn → Payment Channel → Integration Info
# All three are required for payment functionality.
# If absent, storefront still works but checkout returns "payment unavailable".
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Email Service (to be configured when integrating email provider)
EMAIL_API_KEY=
EMAIL_FROM=

# Admin Authentication Secret
ADMIN_SECRET_KEY=

# Order Access Cookie Signing Secret (server-only)
# Signs HttpOnly cookies that authorize customers to view their order details.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for production. Without it, order detail pages will reject all access.
ORDER_ACCESS_SECRET=
